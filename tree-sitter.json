{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "pasp",
      "camelcase": "Pasp",
      "title": "Pasp",
      "scope": "source.pasp",
      "file-types": [
        "str",
        "input",
        "spin_exchange.dat"
      ],
      "injection-regex": "^pasp$",
      "class-name": "TreeSitterPasp"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Pasp grammar for tree-sitter",
    "authors": [
      {
        "name": "LiemuR",
        "email": "tq1l6l3cabc@163.com",
        "url": "https://github.com/LiemuR/"
      }
    ],
    "links": {
      "repository": "https://github.com/LiemuR/tree-sitter-pasp",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}